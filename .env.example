# ---------------------------------------------------------------------------
# Copy file này thành `.env.local` rồi điền giá trị thật.
#   cp .env.example .env.local
# `.env*` đã bị .gitignore bỏ qua, chỉ riêng file mẫu này được commit.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# PostgreSQL (Supabase / Neon / local). Bắt buộc — thiếu thì app không khởi động.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# --- Auth -----------------------------------------------------------------
# Secret ký cookie phiên (bắt buộc với NextAuth v5):
#   openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth (NextAuth v5, database session strategy).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Site -----------------------------------------------------------------
# Dùng để dựng link tuyệt đối trong email bàn giao sau khi thanh toán.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Thanh toán: SePay (BankHub) + VietQR ---------------------------------
# Bỏ trống (hoặc xoá hết khối này) thì app tự dùng payment provider giả lập để
# demo luồng mua local, không cần tài khoản ngân hàng thật.

# API key lấy từ https://my.sepay.vn — dùng để đăng ký webhook VÀ để xác thực
# request gọi vào /api/hooks/sepays (so khớp constant-time).
SEPAY_API_KEY=""

# Mã ngân hách nhận tiền (2 chữ): MB, VP, ACB, TCB, VCB...
SEPAY_BANK_CODE="MB"

# Số tài khoản + tên chủ tài khoản nhận tiền. Đây cũng là số tài khoản nhúng
# vào QR và nội dung hiển thị cho khách.
SEPAY_ACCOUNT_NUMBER=""
SEPAY_ACCOUNT_NAME=""

# Số tài khoản mà webhook được phép xác nhận. Nên đặt riêng khi dùng tài khoản
# "phụ"/tài khoản nhận nhiều dịch vụ: giao dịch về nhầm số khác sẽ bị từ chối.
# Bỏ trống => mặc định bằng SEPAY_ACCOUNT_NUMBER.
SEPAY_EXPECTED_ACCOUNT_NUMBER=""

# Endpoint tạo ảnh QR động. App luôn dựng thêm QR cục bộ từ chính link này nên
# QR vẫn dùng được khi máy khách chặn api.vietqr.io.
SEPAY_VIETQR_ENDPOINT="https://api.vietqr.io/v2/create"

# --- Email bàn giao -------------------------------------------------------
# Chưa cấu hình SMTP thì hệ thống ghi log nội dung email ra console
# (xem src/infrastructure/notifications/).
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# EMAIL_FROM="PromptWorks <no-reply@example.com>"
