generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "authentication", "catalog", "payment", "apps", "audit", "ai"]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  ADMIN
  @@schema("authentication")
}

enum UserStatus {
  ACTIVE
  BLOCKED
  @@schema("authentication")
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELED
  FAILED
  REFUNDED
  @@schema("payment")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
  REFUNDED
  @@schema("payment")
}

enum SkillAccessSource {
  ORDER
  ADMIN_GRANT
  PROMOTION
  @@schema("payment")
}

enum SkillAccessType {
  FREE
  PAID
  @@schema("catalog")
}

enum WebhookEventStatus {
  RECEIVED
  MATCHED
  REJECTED
  FAILED
  @@schema("payment")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  @@schema("catalog")
}

enum AIToolStatus {
  ACTIVE
  INACTIVE
  @@schema("catalog")
}

enum RankingPeriodType {
  WEEK
  MONTH
  QUARTER
  ALL_TIME
  @@schema("catalog")
}

enum RankingStatus {
  DRAFT
  PUBLISHED
  @@schema("catalog")
}

enum ToolType {
  DOWNLOADABLE // App máy tính tải về (EXE, DMG, ZIP...)
  EMBED_WIDGET // Widget nhúng Web doanh nghiệp (Chatbox, Popup...)
  MCP_SERVER // MCP Server cho AI Agent
  WEB_APP // Web App dùng trực tiếp
  @@schema("catalog")
}

enum ToolBillingType {
  FREE // Miễn phí
  ONE_TIME // Mua đứt 1 lần
  SUBSCRIPTION // Mua/gia hạn theo chu kỳ (tháng, năm)
  @@schema("catalog")
}

// ---------------------------------------------------------------------------
// Identity (Auth.js Prisma adapter compatible)
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(uuid())
  name          String?    @db.VarChar(120)
  email         String?    @unique @db.VarChar(320)
  emailVerified DateTime?  @db.Timestamptz(3)
  image         String?
  role          UserRole   @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?  @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)

  accounts    Account[]
  sessions    Session[]
  favorites   SkillFavorite[]
  skillViews  SkillView[]
  toolClicks  ToolClick[]
  skills      Skill[]
  orders      Order[]
  skillAccess SkillAccess[]
  auditLogs   AuditLog[]      @relation("AuditActor")
  subscriptions UserSubscription[]
  oauthAccessTokens OAuthAccessToken[]
  oauthRefreshTokens OAuthRefreshToken[]
  authorizationCodes AuthorizationCode[]

  @@map("users")
  @@schema("authentication")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@schema("authentication")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@schema("authentication")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
  @@schema("authentication")
}

// ---------------------------------------------------------------------------
// Taxonomy
// ---------------------------------------------------------------------------

model Industry {
  id          String   @id @default(uuid())
  slug        String   @unique @db.VarChar(120)
  name        String   @db.VarChar(160)
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  skills   SkillIndustryLink[]
  rankings Ranking[]

  @@map("industries")
  @@schema("catalog")
}

model SkillCategory {
  id          String   @id @default(uuid())
  slug        String   @unique @db.VarChar(120)
  name        String   @db.VarChar(160)
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  skills   SkillCategoryLink[]
  rankings Ranking[]

  @@map("skill_categories")
  @@schema("catalog")
}

model UseCase {
  id          String   @id @default(uuid())
  slug        String   @unique @db.VarChar(160)
  name        String   @db.VarChar(200)
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  skills SkillUseCaseLink[]
  @@schema("catalog")
}

model AITool {
  id          String       @id @default(uuid())
  slug        String       @unique @db.VarChar(160)
  name        String       @db.VarChar(200)
  description String?
  websiteUrl  String?
  logoUrl     String?
  status      AIToolStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  skills         SkillToolLink[]
  newsLinks      NewsToolLink[]
  rankingEntries RankingEntry[]
  clicks         ToolClick[]

  @@index([status])
  @@schema("catalog")
}

// ---------------------------------------------------------------------------
// Skill catalog
// ---------------------------------------------------------------------------

model Skill {
  id               String          @id @default(uuid())
  slug             String          @unique @db.VarChar(180)
  title            String          @db.VarChar(200)
  shortDescription String          @db.VarChar(500)
  description      String          @db.Text
  accessType       SkillAccessType @default(FREE)
  status           ContentStatus   @default(DRAFT)
  authorId         String?
  coverImageUrl    String?
  /// Link video demo (YouTube/Vimeo/MP4 public hoặc file đã upload lên R2).
  videoDemoUrl     String?
  viewCount        BigInt          @default(0)
  favoriteCount    BigInt          @default(0)
  ratingAverage    Decimal?        @db.Decimal(3, 2)
  ratingCount      Int             @default(0)
  publishedAt      DateTime?       @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)

  versions    SkillVersion[]
  prices      SkillPrice[]
  categories  SkillCategoryLink[]
  industries  SkillIndustryLink[]
  useCases    SkillUseCaseLink[]
  tools       SkillToolLink[]
  favorites   SkillFavorite[]
  views       SkillView[]
  orders      Order[]
  skillAccess SkillAccess[]
  author      User?               @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([accessType])
  @@index([favoriteCount])
  @@index([createdAt])
  @@schema("catalog")
}

model SkillVersion {
  id           String   @id @default(uuid())
  skillId      String
  version      Int
  content      String   @db.Text
  instructions String?  @db.Text
  variables    Json?
  changelog    String?  @db.Text
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, version])
  @@index([skillId, version])
  @@schema("catalog")
}

model SkillPrice {
  id        String   @id @default(uuid())
  skillId   String
  currency  String   @db.Char(3)
  amount    Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId, isActive])
  @@schema("catalog")
}

model SkillCategoryLink {
  skillId    String
  categoryId String

  skill    Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  category SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([skillId, categoryId])
  @@index([categoryId, skillId])
  @@schema("catalog")
}

model SkillIndustryLink {
  skillId    String
  industryId String

  skill    Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  industry Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@id([skillId, industryId])
  @@index([industryId, skillId])
  @@schema("catalog")
}

model SkillUseCaseLink {
  skillId   String
  useCaseId String

  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  useCase UseCase @relation(fields: [useCaseId], references: [id], onDelete: Cascade)

  @@id([skillId, useCaseId])
  @@index([useCaseId, skillId])
  @@schema("catalog")
}

model SkillToolLink {
  skillId String
  toolId  String

  skill Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  tool  AITool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([skillId, toolId])
  @@index([toolId, skillId])
  @@schema("catalog")
}

// ---------------------------------------------------------------------------
// News
// ---------------------------------------------------------------------------

model NewsArticle {
  id            String        @id @default(uuid())
  slug          String        @unique @db.VarChar(220)
  title         String        @db.VarChar(260)
  excerpt       String?       @db.VarChar(600)
  content       String        @db.Text
  coverImageUrl String?
  sourceName    String        @db.VarChar(160)
  sourceUrl     String?
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?     @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  category   NewsCategory? @relation("NewsArticleCategory", fields: [categoryId], references: [id])
  categoryId String?

  tools NewsToolLink[]

  @@index([status, publishedAt])
  @@index([sourceName])
  @@index([categoryId, status])
  @@map("news_articles")
  @@schema("catalog")
}

model NewsCategory {
  id        String   @id @default(uuid())
  slug      String   @unique @db.VarChar(160)
  name      String   @db.VarChar(200)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  articles NewsArticle[] @relation("NewsArticleCategory")

  @@map("news_categories")
  @@schema("catalog")
}

model NewsToolLink {
  articleId String
  toolId    String

  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tool    AITool      @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([articleId, toolId])
  @@index([toolId, articleId])
  @@schema("catalog")
}

// ---------------------------------------------------------------------------
// Rankings
// ---------------------------------------------------------------------------

model Ranking {
  id          String            @id @default(uuid())
  name        String            @db.VarChar(220)
  slug        String            @unique @db.VarChar(220)
  industryId  String?
  categoryId  String?
  periodType  RankingPeriodType @default(MONTH)
  periodStart DateTime?         @db.Timestamptz(3)
  periodEnd   DateTime?         @db.Timestamptz(3)
  status      RankingStatus     @default(DRAFT)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  industry Industry?      @relation(fields: [industryId], references: [id])
  category SkillCategory? @relation(fields: [categoryId], references: [id])
  entries  RankingEntry[]

  @@index([status])
  @@index([industryId, status])
  @@index([categoryId, status])
  @@schema("catalog")
}

model RankingEntry {
  id        String  @id @default(uuid())
  rankingId String
  toolId    String
  score     Decimal @db.Decimal(12, 4)
  views     BigInt  @default(0)
  favorites BigInt  @default(0)
  clicks    BigInt  @default(0)
  rank      Int

  ranking Ranking @relation(fields: [rankingId], references: [id], onDelete: Cascade)
  tool    AITool  @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([rankingId, toolId])
  @@index([rankingId, rank])
  @@index([toolId])
  @@schema("catalog")
}

// ---------------------------------------------------------------------------
// Engagement
// ---------------------------------------------------------------------------

model SkillFavorite {
  userId    String
  skillId   String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([skillId, createdAt])
  @@schema("catalog")
}

model SkillView {
  id          String   @id @default(uuid())
  skillId     String
  userId      String?
  sessionHash String?  @db.VarChar(64)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([skillId, createdAt])
  @@index([userId, createdAt])
  @@schema("catalog")
}

model ToolClick {
  id        String   @id @default(uuid())
  toolId    String
  userId    String?
  source    String   @db.VarChar(80)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  tool AITool @relation(fields: [toolId], references: [id], onDelete: Cascade)
  user User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([toolId, createdAt])
  @@schema("catalog")
}

// ---------------------------------------------------------------------------
// Tool catalog & distribution
//
// `amount` của ToolPrice dùng đơn vị nhỏ (minor units) giống SkillPrice để
// dùng chung `toMinorUnits`/`formatMoney`. Mỗi Tool chỉ có một phiên bản
// "latest" tại thời điểm hiện tại; lịch sử phiên bản sẽ bổ sung ở phase sau.
// ---------------------------------------------------------------------------

model Tool {
  id               String          @id @default(uuid())
  slug             String          @unique @db.VarChar(180)
  title            String          @db.VarChar(200)
  shortDescription String          @db.VarChar(500)
  description      String          @db.Text
  type             ToolType        @default(DOWNLOADABLE)
  billingType      ToolBillingType @default(SUBSCRIPTION)
  status           ContentStatus   @default(DRAFT)
  coverImageUrl    String?
  /// Link video demo (YouTube/Vimeo/MP4 public hoặc file đã upload lên R2).
  videoDemoUrl     String?
  /// Cấu hình riêng theo loại tool, ví dụ:
  /// - WEB_APP: { "appUrl": "https://app.example.com" }
  /// - EMBED_WIDGET: { "defaultTheme": "dark", "allowedDomains": ["*"] }
  /// - MCP_SERVER: { "command": "npx", "args": ["-y", "@modelcontextprotocol/..."] }
  config           Json?
  publishedAt      DateTime?       @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)

  prices   ToolPrice[]
  versions ToolVersion[]

  @@index([status, publishedAt])
  @@index([type, status])
  @@index([billingType])
  @@map("tools")
  @@schema("catalog")
}

model ToolPrice {
  id           String   @id @default(uuid())
  toolId       String
  currency     String   @default("USD") @db.Char(3)
  /// Số tiền ở đơn vị nhỏ, ví dụ 9 USD => 900.
  amount       Int
  /// Số ngày cấp quyền (30 = tháng, 365 = năm, 0 = vĩnh viễn).
  durationDays Int      @default(30)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([toolId, isActive])
  @@map("tool_prices")
  @@schema("catalog")
}

model ToolVersion {
  id          String   @id @default(uuid())
  toolId      String
  /// Mã phiên bản hiển thị cho người dùng, ví dụ "1.0.0".
  versionCode String   @db.VarChar(50)
  changelog   String?  @db.Text
  /// DOWNLOADABLE: tệp đã upload lên Cloudflare R2.
  fileUrl     String?  @db.Text
  fileName    String?  @db.VarChar(200)
  fileSize    BigInt?
  /// EMBED_WIDGET / MCP_SERVER: link script CDN hoặc file cấu hình.
  scriptUrl   String?  @db.Text
  isLatest    Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([toolId, versionCode])
  @@index([toolId, isLatest])
  @@map("tool_versions")
  @@schema("catalog")
}

// ---------------------------------------------------------------------------
// Commerce: orders, payments & skill access
// ---------------------------------------------------------------------------

model Order {
  id          String      @id @default(uuid())
  orderCode   String      @unique @db.VarChar(40)
  userId      String
  // Email nhận hàng chụp tại thời điểm tạo đơn, dùng để giao link sản phẩm.
  email       String?     @db.VarChar(320)
  // Loại sản phẩm. Hiện chỉ có "SKILL"; giữ cột riêng để mở rộng bundle/pack
  // mà không phải đổi luồng thanh toán. Skill vẫn được ràng buộc bằng khóa ngoại.
  productType String      @default("SKILL") @db.VarChar(24)
  /// SKILL: khóa ngoại tới catalog.skills. APP_PLAN: null.
  skillId     String?
  /// APP_PLAN: id của apps.subscription_plan_prices (không FK vì khác module; apps tự kiểm tra).
  planPriceId String?     @db.VarChar(64)
  /// Tên sản phẩm chụp lúc tạo đơn (VD "DirectorCraft Pro · 6 tháng") để email/đơn hàng không phải join chéo module.
  productTitle String?    @db.VarChar(240)
  /// Đường dẫn tương đối tới trang sản phẩm (VD "/apps/video-tool/pricing").
  productPath  String?    @db.VarChar(240)
  amount      Decimal     @db.Decimal(12, 2)
  currency    String      @default("VND") @db.VarChar(8)
  status      OrderStatus @default(PENDING)
  expiresAt   DateTime    @db.Timestamptz(3)
  paidAt      DateTime?   @db.Timestamptz(3)
  canceledAt  DateTime?   @db.Timestamptz(3)
  refundedAt  DateTime?   @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  user          User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  skill         Skill?               @relation(fields: [skillId], references: [id], onDelete: Restrict)
  transactions  PaymentTransaction[]
  skillAccess   SkillAccess?
  webhookEvents WebhookEvent[]

  @@index([userId])
  @@index([skillId])
  @@index([planPriceId])
  @@index([status])
  @@index([createdAt])
  @@index([status, expiresAt])
  @@map("orders")
  @@schema("payment")
}

model PaymentTransaction {
  id                    String        @id @default(uuid())
  orderId               String
  provider              String        @db.VarChar(60)
  providerTransactionId String        @unique @db.VarChar(160)
  amount                Decimal       @db.Decimal(12, 2)
  status                PaymentStatus
  rawPayload            Json?
  paidAt                DateTime?     @db.Timestamptz(3)
  verifiedAt            DateTime?     @db.Timestamptz(3)
  createdAt             DateTime      @default(now()) @db.Timestamptz(3)
  webhookEventId        String?

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  webhookEvent WebhookEvent? @relation(fields: [webhookEventId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@map("payment_transactions")
  @@schema("payment")
}

// Nhật ký thô mọi webhook nhận về: đối soát, chống trùng lặp và debug.
// Ghi cho cả webhook không khớp đơn, vì tiền đã vào tài khoản thì phải truy vết được.
model WebhookEvent {
  id              String             @id @default(uuid())
  provider        String             @db.VarChar(60)
  providerEventId String             @db.VarChar(160)
  gateway         String             @db.VarChar(120)
  accountNumber   String             @db.VarChar(64)
  subAccount      String?            @db.VarChar(64)
  amountIn        Decimal            @db.Decimal(18, 2)
  accumulated     Decimal?           @db.Decimal(18, 2)
  code            String?            @db.VarChar(120)
  content         String?
  /// credit = tiền vào (mới có thể mở khoá đơn), debit = tiền ra (bất thường).
  transferType    String?            @db.VarChar(16)
  referenceNumber String?            @db.VarChar(120)
  referenceCode   String?            @db.VarChar(120)
  description     String?
  transactionDate String?            @db.VarChar(40)
  status          WebhookEventStatus @default(RECEIVED)
  failureReason   String?            @db.VarChar(200)
  orderId         String?
  orderCode       String?            @db.VarChar(40)
  rawPayload      Json
  receivedAt      DateTime           @default(now()) @db.Timestamptz(3)
  processedAt     DateTime?          @db.Timestamptz(3)

  order               Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paymentTransactions PaymentTransaction[]

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
  @@index([orderId])
  @@index([referenceNumber])
  @@index([receivedAt])
  @@map("webhook_events")
  @@schema("payment")
}

model SkillAccess {
  id        String            @id @default(uuid())
  userId    String
  skillId   String
  orderId   String?           @unique
  source    SkillAccessSource
  grantedAt DateTime          @default(now()) @db.Timestamptz(3)
  revokedAt DateTime?         @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)

  user  User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  skill Skill  @relation(fields: [skillId], references: [id], onDelete: Restrict)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([userId, skillId])
  @@index([skillId])
  @@map("skill_accesses")
  @@schema("payment")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String
  action      String   @db.VarChar(80)
  entityType  String   @db.VarChar(80)
  entityId    String?
  metadata    Json?
  ipAddress   String?  @db.VarChar(64)
  userAgent   String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  actor User @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
  @@schema("audit")
}

// ---------------------------------------------------------------------------
// OAuth2 / OIDC provider (schema: authentication)
// ---------------------------------------------------------------------------

model OAuthClient {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(160)
  /// Public client_id g?i t? app/web/tool b�n th? ba.
  clientId     String   @unique @db.VarChar(120)
  /// SHA-256 hash c?a client secret; client public (desktop/mobile/PKCE-only) th� null.
  clientSecretHash String? @db.VarChar(128)
  /// Danh s�ch redirect_uri du?c ph�p (authorize ph?i exact-match).
  redirectUris Json
  /// Scopes client du?c ph�p xin, v� d? ["openid","profile","email"].
  scopes       Json
  /// Public client (SPA/desktop/mobile) kh�ng c� secret, b?t bu?c PKCE.
  isPublic     Boolean  @default(true)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  authorizationCodes AuthorizationCode[]
  accessTokens       OAuthAccessToken[]
  refreshTokens      OAuthRefreshToken[]

  @@index([isActive])
  @@map("oauth_clients")
  @@schema("authentication")
}

model AuthorizationCode {
  id            String   @id @default(uuid())
  code          String   @unique @db.VarChar(160)
  clientId      String
  userId        String
  redirectUri   String   @db.Text
  scopes        Json
  /// PKCE: code_challenge nh?n t? authorize.
  codeChallenge String   @db.VarChar(256)
  codeChallengeMethod String @db.VarChar(16)
  expiresAt     DateTime @db.Timestamptz(3)
  consumedAt    DateTime? @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@map("oauth_authorization_codes")
  @@schema("authentication")
}

model OAuthAccessToken {
  id        String   @id @default(uuid())
  /// SHA-256 hash c?a token (JWT ho?c opaque), kh�ng luu plaintext.
  tokenHash String   @unique @db.VarChar(128)
  clientId  String
  userId    String
  scopes    Json
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens OAuthRefreshToken[]

  @@index([clientId])
  @@index([userId])
  @@map("oauth_access_tokens")
  @@schema("authentication")
}

model OAuthRefreshToken {
  id             String   @id @default(uuid())
  tokenHash      String   @unique @db.VarChar(128)
  clientId       String
  userId         String
  accessTokenId  String?
  scopes         Json
  expiresAt      DateTime @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  /// Refresh token xoay v�ng: token cu tr? t?i token thay th?.
  replacedById   String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  client      OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken OAuthAccessToken? @relation(fields: [accessTokenId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([userId])
  @@map("oauth_refresh_tokens")
  @@schema("authentication")
}

// ---------------------------------------------------------------------------
// Apps, menu & subscription (schema: apps)
// ---------------------------------------------------------------------------

enum AppType {
  WEB_APP
  DESKTOP_TOOL
  MOBILE_APP
  EMBED_WIDGET
  MCP_SERVER
  @@schema("apps")
}

enum AppStatus {
  ACTIVE
  INACTIVE
  @@schema("apps")
}

enum MenuAccess {
  FREE
  PAID
  @@schema("apps")
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
  PENDING
  @@schema("apps")
}

model App {
  id          String    @id @default(uuid())
  slug        String    @unique @db.VarChar(160)
  name        String    @db.VarChar(200)
  description String?
  type        AppType   @default(WEB_APP)
  status      AppStatus @default(ACTIVE)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  sources       AppSource[]
  releases      AppRelease[]
  menus         AppMenuItem[]
  plans         SubscriptionPlan[]
  subscriptions UserSubscription[]

  @@index([status])
  @@map("apps")
  @@schema("apps")
}

/// Menu hi?n th? trong m?t app; item PAID ch? m? khi t�i kho?n c� g�i h?p l?.
model AppMenuItem {
  id        String     @id @default(uuid())
  appId     String
  parentId  String?
  label     String     @db.VarChar(160)
  path      String?    @db.VarChar(400)
  icon      String?    @db.VarChar(80)
  sortOrder Int        @default(0)
  access    MenuAccess @default(FREE)
  /// N?u set, g�i c?a user ph?i ch?a d�ng feature n�y m?i m?; null = ch? c?n g�i c�n h?n.
  requiredFeatureId String?
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)

  app             App  @relation(fields: [appId], references: [id], onDelete: Cascade)
  parent          AppMenuItem? @relation("MenuTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        AppMenuItem[] @relation("MenuTree")
  requiredFeature Feature? @relation(fields: [requiredFeatureId], references: [id], onDelete: SetNull)

  @@index([appId, parentId, sortOrder])
  @@map("app_menu_items")
  @@schema("apps")
}

/// Feature d?nh nghia ? c?p h? th?ng, g?n v�o g�i qua PlanFeature.
model Feature {
  id          String  @id @default(uuid())
  key         String  @unique @db.VarChar(120)
  name        String  @db.VarChar(200)
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  plans  PlanFeature[]
  menus  AppMenuItem[]

  @@map("features")
  @@schema("apps")
}

/// Gói = tầng tính năng (VD: Pro). Giá và thời hạn nằm ở SubscriptionPlanPrice
/// để một gói bán được nhiều kỳ hạn (1 tháng, 6 tháng, 12 tháng, vĩnh viễn) mà không lặp danh sách tính năng.
model SubscriptionPlan {
  id          String   @id @default(uuid())
  appId       String
  name        String   @db.VarChar(160)
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  app           App                     @relation(fields: [appId], references: [id], onDelete: Cascade)
  features      PlanFeature[]
  prices        SubscriptionPlanPrice[]
  subscriptions UserSubscription[]

  @@index([appId, isActive])
  @@map("subscription_plans")
  @@schema("apps")
}

/// Một kỳ hạn bán của gói. Thời hạn tính theo THÁNG LỊCH (không phải 30 ngày) để "6 tháng" luôn đúng 6 tháng.
model SubscriptionPlanPrice {
  id        String   @id @default(uuid())
  planId    String
  /// Số tháng hiệu lực (1, 6, 12...). 0 = vĩnh viễn.
  months    Int
  currency  String   @default("VND") @db.Char(3)
  /// Đơn vị nhỏ nhất của tiền tệ, VD 99000 = 99.000 VND.
  amount    Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, months, currency])
  @@index([planId, isActive])
  @@map("subscription_plan_prices")
  @@schema("apps")
}

model PlanFeature {
  planId    String
  featureId String

  plan    SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature          @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([planId, featureId])
  @@index([featureId])
  @@map("plan_features")
  @@schema("apps")
}

model UserSubscription {
  id        String             @id @default(uuid())
  userId    String
  appId     String
  planId    String
  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime           @db.Timestamptz(3)
  /// null = không hết hạn (gói vĩnh viễn).
  endsAt    DateTime?          @db.Timestamptz(3)
  /// Đơn hàng thanh toán (payment.orders.id) đã tạo ra kỳ này. Unique để webhook gửi lặp không cộng thời hạn 2 lần.
  orderId   String?            @unique @db.VarChar(64)
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @db.Timestamptz(3)

  user User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  app  App             @relation(fields: [appId], references: [id], onDelete: Restrict)
  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, appId, status])
  @@index([appId, status, endsAt])
  @@map("user_subscriptions")
  @@schema("apps")
}

// ---------------------------------------------------------------------------
// AI Gateway (Modular AI Gateway Service)
// ---------------------------------------------------------------------------

enum AiClientStatus {
  ACTIVE
  SUSPENDED
  @@schema("ai")
}

enum AiKeyStatus {
  ACTIVE
  RATE_LIMITED
  SUSPENDED
  EXPIRED
  @@schema("ai")
}

enum AiTaskType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  EMBEDDING
  @@schema("ai")
}

enum AiTaskStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  @@schema("ai")
}

enum AiCallbackStatus {
  NONE
  PENDING
  DELIVERED
  FAILED
  @@schema("ai")
}

/// Client ứng dụng (nội bộ hoặc bên ngoài) được cấp quyền gọi AI Gateway
model AiClient {
  id               String         @id @default(uuid())
  name             String         @db.VarChar(160)
  apiKey           String         @unique @db.VarChar(128)
  status           AiClientStatus @default(ACTIVE)
  rateLimitPerMin  Int            @default(60)
  allowedProviders String[]       @default([])
  allowedTasks     String[]       @default([])
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)

  providerKeys     AiProviderKey[]
  tasks            AiTask[]
  usageLogs        AiUsageLog[]

  @@index([status])
  @@map("ai_clients")
  @@schema("ai")
}

/// Kho API Key của các nhà cung cấp AI với cơ chế xoay vòng và Circuit Breaker
model AiProviderKey {
  id            String      @id @default(uuid())
  provider      String      @db.VarChar(60) // openai, gemini, anthropic, fal-ai, elevenlabs, etc.
  keySecret     String      @db.Text
  alias         String?     @db.VarChar(120)
  status        AiKeyStatus @default(ACTIVE)
  cooldownUntil DateTime?   @db.Timestamptz(3)
  failureCount  Int         @default(0)
  successCount  Int         @default(0)
  weight        Int         @default(1)
  lastUsedAt    DateTime?   @db.Timestamptz(3)
  /// BYOK: null = Key chung của hệ thống, có clientId = Key riêng của Client
  clientId      String?     @db.VarChar(120)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)

  client        AiClient?   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([provider, status, cooldownUntil])
  @@index([clientId])
  @@map("ai_provider_keys")
  @@schema("ai")
}

/// Tác vụ AI bất đồng bộ (Image / Video / Heavy LLM Queue)
model AiTask {
  id             String           @id @default(uuid())
  clientId       String?          @db.VarChar(120)
  taskType       AiTaskType
  status         AiTaskStatus     @default(PENDING)
  provider       String           @db.VarChar(60)
  model          String           @db.VarChar(120)
  prompt         String?          @db.Text
  inputParams    Json?
  outputResult   Json?
  errorMessage   String?          @db.Text
  callbackUrl    String?          @db.VarChar(500)
  callbackStatus AiCallbackStatus @default(NONE)
  executionTimeMs Int?
  tokensConsumed Int?
  costUsd        Decimal?         @db.Decimal(10, 6)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  client         AiClient?        @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([clientId, createdAt])
  @@map("ai_tasks")
  @@schema("ai")
}

/// Nhật ký sử dụng, Token Tracking & Audit Log cho Gateway
model AiUsageLog {
  id               String     @id @default(uuid())
  clientId         String?    @db.VarChar(120)
  taskId           String?    @db.VarChar(120)
  taskType         AiTaskType
  provider         String     @db.VarChar(60)
  model            String     @db.VarChar(120)
  promptTokens     Int        @default(0)
  completionTokens Int        @default(0)
  totalTokens      Int        @default(0)
  latencyMs        Int        @default(0)
  statusCode       Int        @default(200)
  errorMessage     String?    @db.Text
  ipAddress        String?    @db.VarChar(64)
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)

  client           AiClient?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([provider, model, createdAt])
  @@map("ai_usage_logs")
  @@schema("ai")
}


// Distribution artifacts and pinned releases, entirely within apps schema.
model AppSource {
  id               String @id @default(uuid())
  appId            String
  key              String @db.VarChar(80)
  name             String @db.VarChar(200)
  version          String @db.VarChar(40)
  kind             String @db.VarChar(20)
  format           String @db.VarChar(10)
  platform         String @db.VarChar(40)
  url              String @db.Text
  sha256           String @db.Char(64)
  size             Float
  fileName         String @db.VarChar(200)
  installDirectory String @db.VarChar(240)
  entryPoint       String @db.VarChar(240)
  requiredFiles    Json @default("[]")
  description      String @default("") @db.Text
  metadata         Json @default("{}")
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
  app              App @relation(fields: [appId], references: [id], onDelete: Restrict)
  items            AppReleaseItem[]
  @@unique([appId, key, version, platform])
  @@index([url])
  @@map("app_sources")
  @@schema("apps")
}
model AppRelease {
  id          String @id @default(uuid())
  appId       String
  version     String @db.VarChar(40)
  channel     String @default("stable") @db.VarChar(20)
  platform    String @default("win-x64") @db.VarChar(40)
  status      String @default("DRAFT") @db.VarChar(20)
  notes       String @default("") @db.Text
  publishedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  app         App @relation(fields: [appId], references: [id], onDelete: Restrict)
  items       AppReleaseItem[]
  @@unique([appId, version, channel, platform])
  @@index([appId, channel, platform, status])
  @@map("app_releases")
  @@schema("apps")
}
model AppReleaseItem {
  releaseId String
  sourceId  String
  release AppRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  source AppSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  @@id([releaseId, sourceId])
  @@index([sourceId])
  @@map("app_release_items")
  @@schema("apps")
}
